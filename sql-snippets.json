	"Search SQL Objects": {
		"prefix": "searchsql",
		"body": ["SELECT DISTINCT",
				"\ts.name as schema_name,",
				"\to.name AS Object_Name,",
				"\to.type_desc",
				"-- select * ",
				"FROM sys.sql_modules m",
				"\tINNER JOIN sys.objects o ON m.object_id = o.object_id",
				"\tleft join sys.schemas s on o.schema_id=s.schema_id",
				"WHERE m.definition Like '%${1:SearchString}%'"],
		"description": "Custom query to locate items in SQL"
	},
	"SQL Search Objects": {
		"prefix": "sqlsearch",
		"body": ["SELECT DISTINCT",
				"\ts.name as schema_name,",
				"\to.name AS Object_Name,",
				"\to.type_desc",
				"-- select * ",
				"FROM sys.sql_modules m",
				"\tINNER JOIN sys.objects o ON m.object_id = o.object_id",
				"\tleft join sys.schemas s on o.schema_id=s.schema_id",
				"WHERE m.definition Like '%${1:SearchString}%'"],
		"description": "Custom query to locate items in SQL"
	},
	"Select Running Total with DateInt": {
		"prefix": "ssrundateint",
		"body": ["SELECT [dt].[salesYearInt],dt.dateint,",
				"\tFORMAT([dt].[count], 'N0') TotalRecords,",
				"\tFORMAT(SUM([count])",
				"\t\tOVER (ORDER BY salesYearInt, dateInt",
				"\t\tROWS BETWEEN UNBOUNDED PRECEDING and CURRENT ROW",
				"\t), 'N0')",
				"as",
				"running_total",
				"FROM (",
				"\tSELECT i.salesYearInt, dateInt, count(1) [count] -- select top 1 * ",
				"\tFROM ${1:TableName} i",
				"\tGROUP BY i.salesYearInt, i.dateint",
				") dt",
				"ORDER BY dt.SalesYearInt"
			],
		"description": "Custom Running Total with DateInt"
	},
	"Select Running Total": {
		"prefix": "ssrun",
		"body": ["SELECT [dt].[salesYearInt],",
				"\tFORMAT([dt].[count], 'N0') TotalRecords,",
				"\tFORMAT(SUM([count])",
				"\t\tOVER (ORDER BY salesYearInt",
				"\t\tROWS BETWEEN UNBOUNDED PRECEDING and CURRENT ROW",
				"\t), 'N0')",
				"as",
				"running_total",
				"FROM (",
				"\tSELECT i.salesYearInt, count(1) [count] -- select top 1 * ",
				"\tFROM ${1:TableName} i",
				"\tGROUP BY i.salesYearInt",
				") dt",
				"ORDER BY dt.SalesYearInt"
			],
		"description": "Custom Running Total with DateInt"
	},
